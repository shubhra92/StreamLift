SERVER_HOST=http://localhost:4000
DATABASE_URL=postgresql://...

# Worker credential encryption key (AES-256-GCM, 32-byte hex)
ENCRYPTION_KEY=

# Optional: used once at worker registration to show the current tunnel IP's
# country flag. Get a server-only token from IPinfo; never expose it as NEXT_PUBLIC_.
IPINFO_TOKEN=

# Set to "true" to use the backend server as the storage destination instead of cloud storage
# NEXT_PUBLIC_SERVER_DOWNLOAD_ENABLED=true

# Parallel worker→browser download tuning (NEXT_PUBLIC_ = visible to the browser)
# NEXT_PUBLIC_MAX_PARALLEL_PARTS=6
# NEXT_PUBLIC_MIN_PART_SIZE_MB=5

# Slow/stalled part reconnection: parts under the speed floor get a fresh
# connection (resumed from their current offset) instead of crawling forever.
# NEXT_PUBLIC_SLOW_SPEED_KBS=15
# NEXT_PUBLIC_SLOW_WINDOW_SEC=15
# NEXT_PUBLIC_STALL_TIMEOUT_SEC=10
# NEXT_PUBLIC_MAX_SLOW_RESTARTS=8

